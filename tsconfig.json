{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": [
      "node",
      "vite/client"
    ],
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "vite.config.ts",
    "technology-runtime/src"
  ]
}
