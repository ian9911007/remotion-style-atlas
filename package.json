{
  "name": "remotion-style-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node --import tsx scripts/validate.ts && node --import tsx scripts/validate-technology.ts && tsc --noEmit && vite build",
    "studio": "remotion studio src/remotion/index.tsx --no-open",
    "render": "node --import tsx scripts/render.ts",
    "render:changed": "node --import tsx scripts/render.ts --changed",
    "render:all": "node --import tsx scripts/render.ts --all",
    "validate": "node --import tsx scripts/validate.ts",
    "review": "node --import tsx scripts/review.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.ts",
    "assets": "node --import tsx scripts/create-assets.ts",
    "sync:push": "bash scripts/sync-github.sh push",
    "sync:pull": "bash scripts/sync-github.sh pull",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "setup:technology": "python3 ../../scripts/package_runtime.py pm technology-runtime install",
    "prepare:technology": "node scripts/prepare-technology-assets.mjs",
    "predev": "pnpm run prepare:technology",
    "prebuild": "pnpm run prepare:technology",
    "validate:technology": "node --import tsx scripts/validate-technology.ts --write-coverage",
    "sync:technology": "node --import tsx scripts/sync-technology-references.ts",
    "capture:technology": "node --import tsx scripts/capture-technology.ts",
    "test:technology": "node --import tsx tests/technology-browser.ts",
    "test:technology-previews": "node --import tsx tests/technology-previews.ts",
    "postbuild": "node --import tsx tests/technology-build.ts"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.10",
    "sharp": "0.34.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "packageManager": "pnpm@11.19.0",
  "aiSkillsPackageRuntime": {
    "policy": "AI_SKILLS_NODE_RUNTIME/1",
    "projectId": "0864d8f7-4351-40b8-a22b-dd23c6c400cb",
    "mode": "governed"
  }
}
